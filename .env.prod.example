# PRODUCTION-configured environment. Copy to `.env.prod`, fill in REAL secrets, never commit it.
ASPNETCORE_ENVIRONMENT=Production

# No ; = $ ' " characters in the password. Needs upper + lower case, a digit, 8+ characters.
SA_PASSWORD=CHANGE_ME
DB_NAME=MunicipalPermitDb_Prod

# 48+ random characters:   openssl rand -base64 48      (PowerShell: see README)
JWT_KEY=CHANGE_ME
# Base64 of exactly 32 random bytes:   openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME

CORS_ORIGIN=https://your-frontend-domain.example

# The image the pipeline publishes (GitHub username in lowercase / repository name):
API_IMAGE=ghcr.io/jarrahik/municipal-permit-system:latest
