# DEVELOPMENT settings for Docker. Copy to `.env` (never commit the real one).
# Only needed when you run through Docker; pressing F5 in Visual Studio does not use this file.

# Password for the SQL Server container. Needs upper + lower case, a digit, 8+ characters.
# Don't use these characters:  ; = $ ' "
SA_PASSWORD=Your_strong_Passw0rd
DB_NAME=MunicipalPermitDb_Dev

# Dev-only values. The app REFUSES to start with these outside Development.
JWT_KEY=dev-only-insecure-jwt-key-change-me-0123456789
ENCRYPTION_KEY=ZGV2LW9ubHktaW5zZWN1cmUta2V5LTMyLWJ5dGVzISE=

CORS_ORIGIN=http://localhost:3000
